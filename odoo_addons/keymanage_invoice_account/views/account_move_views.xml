<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_show_invoice_line_account" model="ir.ui.view">
        <field name="name">account.move.form.show.invoice.line.account</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='account_id']" position="attributes">
                <attribute name="string">Compte comptable</attribute>
                <attribute name="optional">show</attribute>
                <attribute name="groups"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='price_subtotal']" position="before">
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='account_id']" position="move"/>
            </xpath>
        </field>
    </record>
</odoo>
