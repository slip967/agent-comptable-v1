# KeyManage AI - configuration d'exemple
# Copiez les sections utiles vers agent_local_v1/.env et frontend/.env.

# OpenRouter / IA
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MODEL_FALLBACKS=
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-lite-001
OPENROUTER_VISION_FALLBACK_MODELS=
OPENROUTER_APP_URL=http://localhost:8000
OPENROUTER_APP_NAME=KeyManage AI

# CouchDB
COUCHDB_DATABASE=your_couchdb_database_here

# PDF path mapping: linux_prefix=windows_prefix pairs separated by ;
PDF_PATH_MAPPINGS=/srv/keymanage/pdfs=C:\path\to\pdfs
# Legacy fallback (used when PDF_PATH_MAPPINGS is not set)
PDF_LINUX_PREFIX=/srv/keymanage/pdfs
PDF_WINDOWS_PREFIX=C:\path\to\pdfs

# Odoo 17
ODOO_URL=http://localhost:8069
ODOO_DB=keymanage_db
ODOO_USERNAME=admin@example.com
ODOO_PASSWORD=your_password_here
ODOO_MOCK_MODE=False
# Mapping configurable compte KeyManage:code account.account Odoo France.
# Correspondances vérifiées sur le plan généré par l10n_fr dans keymanage_fr.
ODOO_ACCOUNT_CODE_MAP=601:601000,6063:606300,6152:615200,6155:615500

# Frontend React
VITE_API_BASE_URL=http://127.0.0.1:8000
